# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 읽기용: anon 키 또는 publishable 키 (화면 조회, RLS 읽기 전용)
SUPABASE_READ_KEY=
# 쓰기용: service_role 키 또는 secret 키 (동기화 전용, 절대 브라우저에 노출 금지)
SUPABASE_SECRET_KEY=

# Vercel Cron 인증용 임의의 긴 문자열 (예: openssl rand -hex 32)
CRON_SECRET=

# Claude API (한국어 요약)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 보강·요약 대상 기간(일). KEV 전체는 항상 저장하고, CVE 보강과 요약은 이 기간 안의 항목만 처리합니다.
ENRICH_DAYS=365
SUMMARY_DAYS=180
